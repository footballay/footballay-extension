{
  "name": "footballay-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src package.json tsconfig.json wxt.config.ts .vscode/settings.json",
    "format:check": "prettier --check src package.json tsconfig.json wxt.config.ts .vscode/settings.json",
    "prepare": "wxt prepare"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "axios": "^1.17.0",
    "colorjs.io": "^0.7.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wxt": "^0.20.26"
  }
}
